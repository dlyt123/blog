# ================================================================
# 生产环境私有配置模板
#
# 用法：
#   sudo cp application-local.yml.example /opt/blog/app/application-local.yml
#   sudo vim /opt/blog/app/application-local.yml     # 填真实值
#   sudo chown blog:blog /opt/blog/app/application-local.yml
#   sudo chmod 600 /opt/blog/app/application-local.yml
#
# 说明：两种方式二选一 ——
#   方式 A（推荐）：不改这个文件，改用 systemd 的环境变量注入（见 blog.service）
#   方式 B：用这个文件，敏感值不写进 systemd
# 两者同时存在时，**环境变量优先级更高**。
# ================================================================

spring:
  datasource:
    # ★ 必须用低权限账号，不要用 root
    username: blog_app
    password: 换成数据库密码

blog:
  jwt:
    # ★ 必须是随机长串。生成：
    #   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
    #   或 openssl rand -base64 48
    # 留空或保持默认占位符时，启动日志会打印安全告警
    secret: 换成随机密钥
    expire: 86400

# 生产建议：关闭 SQL 明细日志，避免日志暴涨
logging:
  level:
    root: info
    com.back.backeddemo.mapper: info
